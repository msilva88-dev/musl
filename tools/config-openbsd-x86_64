#!/bin/sh
# Minimal config for OpenBSD/amd64 bootstrap of musl
# Usage: tools/config-openbsd-x86_64
set -eu

# Write config.mak in the repo root, regardless of CWD
topdir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)

# Tool overrides (env may set CC/AR/RANLIB)
: "${CC:=cc}"
: "${AR:=$(command -v ar 2>/dev/null || echo ar)}"
: "${RANLIB:=}"
if [ -z "${RANLIB}" ]; then
  if command -v ranlib >/dev/null 2>&1; then
    RANLIB=$(command -v ranlib)
  elif command -v llvm-ranlib >/dev/null 2>&1; then
    RANLIB=$(command -v llvm-ranlib)
  else
    # Last resort: 'true' avoids hard failure, but indexing is skipped.
    RANLIB=true
  fi
fi

cat > "${topdir}/config.mak" <<EOF
ARCH = x86_64
prefix = /usr/local
includedir = \$(prefix)/include
libdir = \$(prefix)/lib
CC = ${CC}
AR = ${AR}
RANLIB = ${RANLIB}
# Global build flags (keep musl's hidden model for libc objects)
CFLAGS += -O2 -pipe -fvisibility=hidden
CPPFLAGS += -D_OPENBSD_SOURCE -U__linux__
LDFLAGS +=

# --- Stage-2 specifics -------------------------------------------------
# The CRT (Scrt1.o/crti.o/crtn.o) must NOT inherit the hidden model,
# otherwise Scrt1.o's reference to __libc_start_main cannot bind to libc.so.
# Unhide CRT and neutralize the internal 'hidden' macro only for CRT:
CFLAGS_CRT += -fvisibility=default
CPPFLAGS_CRT += -DMUSL_NO_HIDDEN

# Install/symlink path for the loader name (musl's ldso == libc.so)
LDSO_PATHNAME = \$(libdir)/ld-musl-\$(ARCH).so.1

TARGET_OS = openbsd
EOF

echo "Wrote ${topdir}/config.mak for OpenBSD/amd64 (stage-2)"
echo "Next:"
echo "  gmake -j\$(sysctl -n hw.ncpu 2>/dev/null || echo 4) lib/libc.so lib/Scrt1.o lib/crti.o lib/crtn.o"
echo "  gmake ldso-symlink   # creates lib/ld-musl-x86_64.so.1 -> libc.so"

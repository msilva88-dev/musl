#!/bin/sh
# Minimal config for OpenBSD/amd64 static bootstrap of musl
# Usage: tools/config-openbsd-x86_64
set -eu

# Write config.mak in the repo root, regardless of CWD
topdir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)

# Tool overrides (env may set CC/AR/RANLIB)
: "${CC:=cc}"
: "${AR:=$(command -v ar 2>/dev/null || echo ar)}"
: "${RANLIB:=}"
if [ -z "${RANLIB}" ]; then
  if command -v ranlib >/dev/null 2>&1; then
    RANLIB=$(command -v ranlib)
  elif command -v llvm-ranlib >/dev/null 2>&1; then
    RANLIB=$(command -v llvm-ranlib)
  else
    # Last resort: 'true' avoids hard failure, but indexing is skipped.
    RANLIB=true
  fi
fi

cat > "${topdir}/config.mak" <<EOF
ARCH = x86_64
prefix = /usr/local
includedir = \$(prefix)/include
libdir = \$(prefix)/lib
CC = ${CC}
AR = ${AR}
RANLIB = ${RANLIB}
CFLAGS += -O2 -pipe -fvisibility=hidden
CPPFLAGS += -D_OPENBSD_SOURCE -U__linux__
LDFLAGS +=
TARGET_OS = openbsd
EOF

echo "Wrote ${topdir}/config.mak for OpenBSD/amd64"
echo "Use GNU make:"
echo "  gmake -j\$(sysctl -n hw.ncpu 2>/dev/null || echo 4) lib/libc.so"
